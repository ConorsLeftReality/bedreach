<Project Sdk="Microsoft.NET.Sdk">

  <!-- BedReach for Linux and macOS: a background agent (no tray). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>bedreach</AssemblyName>
    <RootNamespace>BedReach</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../core/BedReach.Core.csproj" />
  </ItemGroup>

</Project>
